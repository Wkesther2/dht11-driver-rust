{
  "version": "0.2.0",
  "configurations": [
    {
      "preLaunchTask": "${defaultBuildTask}",
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "Debug DHT11",
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": true,
      },
      "chip": "STM32F407VGTx",
      "coreConfigs": [
          {
              "coreIndex": 0,
              "programBinary": "target/thumbv7em-none-eabihf/debug/dht11_test_stm32f407",
              "svdFile": "STM32F407.svd"
          }
      ]
    }
  ]
}